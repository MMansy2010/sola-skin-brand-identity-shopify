<footer class="site-footer" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="page-container">
    
    <div class="footer-top">
      
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" aria-label="Sola Skin Acasă">
          {%- if section.settings.logo_dark != blank -%}
            <img
              src="{{ section.settings.logo_dark | image_url: width: 280 }}"
              alt="Sola Skin"
              class="footer-logo-svg"
              width="140"
              height="auto"
            >
          {%- else -%}
            <img
              src="{{ 'sola-skin-logo-dark.svg' | asset_url }}"
              alt="Sola Skin"
              class="footer-logo-svg"
              width="140"
              height="auto"
            >
          {%- endif -%}
        </a>

        <div class="footer-statement">
          {{ section.settings.brand_statement | default: 'Sola Skin — Beauty. Care. You.' }}
        </div>

        <p class="footer-desc">
          {{ section.settings.brand_bio | default: 'O experiență de îngrijire minimalistă, creată pentru momentele în care alegi să te pui pe primul loc. Eleganță atemporală pentru pielea ta.' }}
        </p>

        <!-- Social Media Links (Rendered only when configured) -->
        {%- if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank -%}
          <div class="footer-social-links">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram Sola Skin">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook Sola Skin">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest Sola Skin">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="4" x2="12" y2="20"></line><line x1="18" y1="10" x2="6" y2="10"></line></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Navigation Column -->
      <div class="footer-col">
        <h4>{{ 'footer.quick_links' | t }}</h4>
        <ul class="footer-links">
          <li><a href="{{ routes.root_url }}">{{ 'navigation.home' | t }}</a></li>
          <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ 'navigation.products' | t }}</a></li>
          <li><a href="/pages/despre-noi">{{ 'navigation.about' | t }}</a></li>
          <li><a href="/pages/rutina-zilnica">{{ 'navigation.routine' | t }}</a></li>
          <li><a href="/pages/contact">{{ 'navigation.contact' | t }}</a></li>
        </ul>
      </div>

      <!-- Customer Care Column -->
      <div class="footer-col">
        <h4>{{ 'footer.customer_care' | t }}</h4>
        <ul class="footer-links">
          <li><a href="/pages/intrebari-frecvente">Întrebări frecvente</a></li>
          <li><a href="/policies/shipping-policy">{{ 'footer.shipping_policy' | t }}</a></li>
          <li><a href="/policies/refund-policy">{{ 'footer.refund_policy' | t }}</a></li>
          <li><a href="/policies/terms-of-service">{{ 'footer.terms_of_service' | t }}</a></li>
          <li><a href="/policies/privacy-policy">{{ 'footer.privacy_policy' | t }}</a></li>
        </ul>
      </div>

      <!-- Contact Info Placeholder -->
      <div class="footer-col">
        <h4>{{ 'footer.contact' | t }}</h4>
        <p style="font-size: 0.88rem; color: #A69E96; line-height: 1.8; margin-bottom: 12px;">
          București, România<br>
          contact@solaskin.ro
        </p>
        <p style="font-size: 0.82rem; color: #77716B;">
          Luni – Vineri: 09:00 – 17:00
        </p>
      </div>

    </div>

    <!-- Footer Bottom Legal & Copyright -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} Sola Skin. {{ 'footer.rights' | t }}
      </div>

      <div class="footer-legal-links">
        <a href="/policies/privacy-policy">{{ 'footer.privacy_policy' | t }}</a>
        <a href="/policies/terms-of-service">{{ 'footer.terms_of_service' | t }}</a>
        <a href="/policies/shipping-policy">{{ 'footer.shipping_policy' | t }}</a>
        <a href="/policies/refund-policy">{{ 'footer.refund_policy' | t }}</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Subsol (Footer)",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "Logo inversat pentru footer"
    },
    {
      "type": "text",
      "id": "brand_statement",
      "label": "Slogan de brand",
      "default": "Sola Skin — Beauty. Care. You."
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Descriere scurtă brand",
      "default": "O experiență de îngrijire minimalistă, creată pentru momentele în care alegi să te pui pe primul loc. Eleganță atemporală pentru pielea ta."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Culoare fundal footer",
      "default": "#171615"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Culoare text footer",
      "default": "#F8F6F1"
    }
  ]
}
{% endschema %}
