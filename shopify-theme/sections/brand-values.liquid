<section class="section-brand-values" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-container">
    
    <div class="values-grid">
      {%- for block in section.blocks -%}
        <div class="value-card" {{ block.shopify_attributes }}>
          <div class="value-icon-wrap">
            {%- case block.settings.icon -%}
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              {%- when 'feather' -%}
                <svg viewBox="0 0 24 24"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path><line x1="16" y1="8" x2="2" y2="22"></line><line x1="17.5" y1="15" x2="9" y2="15"></line></svg>
              {%- when 'sparkle' -%}
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
              {%- when 'sun' -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg>
            {%- endcase -%}
          </div>
          <h3 class="value-title">{{ block.settings.title }}</h3>
          <p class="value-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Valorile Brandului",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Culoare fundal",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Valoare",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramă",
          "options": [
            { "value": "heart", "label": "Inimă / Grijă" },
            { "value": "feather", "label": "Pene / Simplitate" },
            { "value": "sparkle", "label": "Stea / Eleganță" },
            { "value": "sun", "label": "Soare / Ritualuri" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titlu valoare",
          "default": "Grijă pentru tine"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descriere",
          "default": "Fiecare produs este creat pentru a transforma îngrijirea zilnică într-un moment de calm și atenție personală."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valorile Brandului",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "heart",
            "title": "Grijă pentru tine",
            "description": "Fiecare produs este creat pentru a transforma îngrijirea zilnică într-un ritual de calm și atenție personală."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "feather",
            "title": "Simplitate",
            "description": "O abordare curată, fără pași complicați, axată pe esențialul de care pielea ta are nevoie."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "sparkle",
            "title": "Eleganță",
            "description": "Design atemporal, texturi fine și atenție la detalii în fiecare aspect al experienței Sola Skin."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "sun",
            "title": "Ritualuri zilnice",
            "description": "Momente de liniște create special pentru momentele în care alegi să te pui pe primul loc."
          }
        }
      ]
    }
  ]
}
{% endschema %}
