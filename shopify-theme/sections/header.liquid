<header class="site-header" id="site-header">
  <div class="page-container">
    <div class="site-header-inner">
      
      <!-- Mobile Menu Button -->
      <button type="button" class="mobile-menu-toggle" aria-label="{{ 'navigation.menu' | t }}">
        {% render 'icon-menu' %}
      </button>

      <!-- Desktop Navigation Menu -->
      <nav class="header-nav" aria-label="Navigare principală">
        {%- if section.settings.menu != blank -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <a href="{{ link.url }}" class="nav-link {% if link.active %}active{% endif %}">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Romanian Navigation Links -->
          <a href="{{ routes.root_url }}" class="nav-link active">{{ 'navigation.home' | t }}</a>
          <a href="{{ routes.all_products_collection_url }}" class="nav-link">{{ 'navigation.products' | t }}</a>
          <a href="/pages/despre-noi" class="nav-link">{{ 'navigation.about' | t }}</a>
          <a href="/pages/rutina-zilnica" class="nav-link">{{ 'navigation.routine' | t }}</a>
          <a href="/pages/contact" class="nav-link">{{ 'navigation.contact' | t }}</a>
        {%- endif -%}
      </nav>

      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" class="header-logo-link" aria-label="Sola Skin Acasă">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="Sola Skin"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            style="width: {{ section.settings.logo_width }}px; height: auto;"
          >
        {%- else -%}
          <img
            src="{{ 'sola-skin-logo-light.svg' | asset_url }}"
            alt="Sola Skin"
            class="header-logo-svg"
            width="460"
            height="330"
            style="width: {{ section.settings.logo_width }}px;"
          >
        {%- endif -%}
      </a>

      <!-- Header Action Icons -->
      <div class="header-actions">
        <!-- Search Button -->
        <a href="{{ routes.search_url }}" class="header-icon-btn" aria-label="{{ 'general.search' | t }}">
          {% render 'icon-search' %}
        </a>

        <!-- Cart Bag Button -->
        <button
          type="button"
          class="header-icon-btn"
          data-cart-drawer-trigger
          aria-label="{{ 'cart.title' | t }}"
        >
          {% render 'icon-cart' %}
          <span class="cart-count-badge" style="{% if cart.item_count == 0 %}display: none;{% endif %}">
            {{ cart.item_count }}
          </span>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Meniu mobil">
  <div class="mobile-nav-content">
    <div class="mobile-nav-header">
      <img
        src="{{ 'sola-skin-logo-light.svg' | asset_url }}"
        alt="Sola Skin"
        width="53"
        height="38"
        style="height: 38px; width: auto;"
      >
      <button type="button" class="mobile-nav-close" aria-label="{{ 'general.close' | t }}" style="background: none; border: none; cursor: pointer;">
        {% render 'icon-close' %}
      </button>
    </div>

    <ul class="mobile-nav-links">
      {%- if section.settings.menu != blank -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="{{ routes.root_url }}">{{ 'navigation.home' | t }}</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'navigation.products' | t }}</a></li>
        <li><a href="/pages/despre-noi">{{ 'navigation.about' | t }}</a></li>
        <li><a href="/pages/rutina-zilnica">{{ 'navigation.routine' | t }}</a></li>
        <li><a href="/pages/contact">{{ 'navigation.contact' | t }}</a></li>
      {%- endif -%}
    </ul>

    <div class="mobile-nav-footer">
      <p style="font-size: 0.85rem; color: var(--color-muted); margin-bottom: 12px;">Sola Skin — Beauty. Care. You.</p>
      <a href="{{ routes.search_url }}" class="link-editorial">{{ 'general.search' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Antet (Header)",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo personalizat"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 70,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Lățime logo (px)",
      "default": 115
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Meniu principal de navigare",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Antet fix la derulare (Sticky header)",
      "default": true
    }
  ]
}
{% endschema %}
