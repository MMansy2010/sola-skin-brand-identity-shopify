<section class="section-brand-intro" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-container">
    <div class="brand-intro-grid">
      
      <!-- Editorial Photography on Left -->
      <div class="brand-intro-media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {%- else -%}
          <img
            src="{{ 'lifestyle-editorial.jpg' | asset_url }}"
            alt="Sola Skin — Ritualuri de îngrijire"
            loading="lazy"
            width="1200"
            height="896"
          >
        {%- endif -%}
      </div>

      <!-- Narrative Text on Right -->
      <div class="brand-intro-content">
        <div class="editorial-tag">
          {{ section.settings.eyebrow | default: 'Filosofia Sola Skin' }}
        </div>

        <h2 class="brand-intro-heading">
          {{ section.settings.heading | default: 'Un moment doar pentru tine.' }}
        </h2>

        <div class="gold-arc-divider" style="margin: 20px 0 28px 0; justify-content: flex-start;">
          <span></span>
          <svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="3"/></svg>
          <span style="width: 24px;"></span>
        </div>

        <p class="brand-intro-text">
          {{ section.settings.text | default: 'Credem că îngrijirea pielii înseamnă mai mult decât o rutină. Este un moment în care încetinești ritmul, te reconectezi cu tine și alegi să-ți acorzi atenția pe care o meriți. Fiecare formulă este concepută pentru a aduce armonie, simplitate și o stare profundă de bine.' }}
        </p>

        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '/pages/despre-noi' }}" class="btn btn-secondary">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Introducere Brand",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etichetă (Eyebrow)",
      "default": "Filosofia Sola Skin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Un moment doar pentru tine."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text descriptiv",
      "default": "Credem că îngrijirea pielii înseamnă mai mult decât o rutină. Este un moment în care încetinești ritmul, te reconectezi cu tine și alegi să-ți acorzi atenția pe care o meriți."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Text buton",
      "default": "Descoperă povestea noastră"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link buton"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagine editorială"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Culoare fundal",
      "default": "#F8F6F1"
    }
  ],
  "presets": [
    {
      "name": "Introducere Brand"
    }
  ]
}
{% endschema %}
