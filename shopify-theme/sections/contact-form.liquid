<section class="section-contact-form" style="background-color: {{ section.settings.bg_color | default: 'transparent' }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-container page-container-narrow">
    {% render 'contact-form',
      heading: section.settings.heading,
      text: section.settings.text
    %}
  </div>
</section>

{% schema %}
{
  "name": "Formular de contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu formular",
      "default": "Scrie-ne un mesaj"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtitlu / Descriere",
      "default": "Suntem aici pentru a-ți răspunde la orice întrebare legată de ritualurile și produsele Sola Skin."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Culoare fundal",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Spațiere sus (Padding top)",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Spațiere jos (Padding bottom)",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Formular de contact"
    }
  ]
}
{% endschema %}
