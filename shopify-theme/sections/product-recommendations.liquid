<div
  class="product-recommendations-wrapper"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=3"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section-featured-products" style="border-top: 1px solid var(--color-border-subtle); padding: 80px 0;">
      <div class="page-container">
        <div class="section-header">
          <div class="section-eyebrow">{{ 'products.product.recommended' | t }}</div>
          <h2>{{ section.settings.heading | default: 'Completează-ți rutina' | escape }}</h2>
          <p>Produse complementare create pentru a lucra în armonie perfectă.</p>
          <div class="gold-arc-divider">
            <span></span>
            <svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="3"/></svg>
            <span></span>
          </div>
        </div>

        <div class="product-grid">
          {%- for recommendation in recommendations.products -%}
            {% render 'product-card', product: recommendation %}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  // Dynamic Product Recommendations Fetcher
  document.addEventListener('DOMContentLoaded', function() {
    var wrapper = document.querySelector('.product-recommendations-wrapper');
    if (!wrapper) return;
    var requestUrl = wrapper.getAttribute('data-url');
    if (!requestUrl) return;

    fetch(requestUrl)
      .then(function(response) {
        return response.text();
      })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var newRecommendations = doc.querySelector('.product-recommendations-wrapper');
        if (newRecommendations && newRecommendations.innerHTML.trim().length > 0) {
          wrapper.innerHTML = newRecommendations.innerHTML;
        }
      })
      .catch(function(e) {
        // Graceful silent fallback if recommendations fail
      });
  });
</script>

{% schema %}
{
  "name": "Recomandări produse",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Completează-ți rutina"
    }
  ]
}
{% endschema %}
